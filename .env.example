# Directus instance URL (no trailing slash)
VITE_DIRECTUS_URL=http://localhost:8055

# App mode — "dev" or "prod". In "dev", the login form is pre-filled with the
# admin credentials below (if set) and the "Login as Admin (dev)" button is shown.
VITE_MODE=dev

# Default credentials used to pre-fill the login form and back the "Login as Admin (dev)"
# button. Only used when VITE_MODE=dev. Leave unset in any environment you don't fully control.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
